#!/bin/sh
# Canonical ci-fabric entry point. Generated by `ci-fabric init`.
# Local-only: no network service or hosted CI is involved.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# 1. Editable install in the repository virtual environment (preferred).
if [ -x "$ROOT/.venv/bin/python" ] &&    "$ROOT/.venv/bin/python" -c 'import ci_fabric' >/dev/null 2>&1; then
  exec "$ROOT/.venv/bin/python" -m ci_fabric "$@"
fi

# 2. Explicit source checkout.
if [ -n "${CI_FABRIC_SRC:-}" ]; then
  PYTHONPATH="$CI_FABRIC_SRC/src${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m ci_fabric "$@"
fi

# 3. Vendored package inside the repository.
if [ -d "$ROOT/tools/ci-fabric/src/ci_fabric" ]; then
  PYTHONPATH="$ROOT/tools/ci-fabric/src${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m ci_fabric "$@"
fi

# 4. A globally installed console script.
if command -v ci-fabric >/dev/null 2>&1; then
  exec ci-fabric "$@"
fi

echo "ci-fabric is not installed." >&2
echo "Install it into this repository:" >&2
echo "  python3 -m venv .venv && .venv/bin/pip install -e /path/to/ci-fabric" >&2
echo "Or set CI_FABRIC_SRC to the ci-fabric source checkout." >&2
exit 3
