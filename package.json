{
  "name": "@xenos1996/usa",
  "version": "2.26.0",
  "description": "Universal Software Auditor — an open-source, self-adapting audit framework for any project, any stack, any stage",
  "license": "MIT",
  "type": "module",
  "bin": {
    "usa": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rules": "./rules/index.yaml"
  },
  "files": [
    "dist",
    "rules",
    "templates",
    "USA.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "audit",
    "software-audit",
    "security-audit",
    "code-audit",
    "code-review",
    "openssf",
    "owasp-asvs",
    "slsa",
    "sast",
    "agent",
    "llm",
    "template",
    "tech-debt",
    "quality-gate"
  ],
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Er-Sajan-PLG/universal-software-auditor.git"
  },
  "bugs": {
    "url": "https://github.com/Er-Sajan-PLG/universal-software-auditor/issues"
  },
  "homepage": "https://github.com/Er-Sajan-PLG/universal-software-auditor#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "usa": "node --experimental-strip-types src/cli.ts",
    "lint": "eslint .",
    "actions:pin": "node scripts/pin-actions.mjs",
    "actions:check": "node scripts/pin-actions.mjs --check",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "self-audit": "npm run build && node dist/cli.js audit . --out AUDIT.md",
    "docs:sync": "node scripts/sync-docs.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:adrs": "node scripts/check-adrs.mjs",
    "docs:cli": "node scripts/gen-cli-docs.mjs --check",
    "docs:sample": "node scripts/gen-sample-report.mjs --check",
    "docs:asvs": "node scripts/gen-asvs-coverage.mjs --check",
    "docs:manifest": "node scripts/check-manifest.mjs",
    "docs:links": "node scripts/check-links.mjs",
    "protocol:check": "node scripts/check-protocol.mjs",
    "protocol:start": "node scripts/check-session-start.mjs",
    "protocol:auto-update": "node scripts/auto-update-state.mjs",
    "docs:all": "npm run docs:adrs && npm run docs:check && npm run docs:cli && npm run docs:sample && npm run docs:asvs && npm run docs:manifest",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm run format",
    "release": "pnpm run build && changeset publish",
    "prepublishOnly": "pnpm run build"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^5.0.0"
  }
}
