# Dependencies
node_modules/
.env
.env.local
.env.*.local

# Build outputs
dist/
build/
*.egg-info/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Stray lockfiles from other package managers. pnpm-lock.yaml is the one
# this repo commits; an accidental `npm install` here must not re-introduce
# a second source of truth for the dependency graph.
package-lock.json
yarn.lock

# Test artifacts
test-results/
coverage/

# Hook scratch files. lint-staged backs the staged files up here before running
# and deletes them afterwards; a commit that lands while the hook is still
# cleaning up leaves one behind, and the post-commit hook's `git add -A` then
# commits it. Seven empty files reached PR #190 this way — they are never
# content, so they are ignored rather than deleted after the fact.
_tmp_*

# Local config
config.local.json
.local/

# Secrets (never commit)
*.pem
*.key
*.crt
secrets/
credentials/
# Generated audit reports (root-level scratch; canonical reports live under
# experiments/<run_id>/ per docs/EXPERIMENT_PROTOCOL.md)
/AUDIT.md
/AUDIT_*.md
# `usa docs audit` (doc-universe gate) writes this to the repo root by default;
# CI overrides it via --out, but local runs leave a stray untracked copy.
/DOC-AUDIT.md

# `usa scan` writes one evidence artifact per run. They are run outputs, not
# sources: a project that wants a rule to cite one copies it somewhere stable
# (reports/, provenance/) or commits it deliberately with `git add -f`.
.usa/evidence/
